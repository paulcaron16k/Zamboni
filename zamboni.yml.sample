# Zamboni profile: everything that is not a secret.
#
#   cp zamboni.yml.sample zamboni.yml
#
# Found automatically at ./zamboni.yml, then $ZAMBONI_ROOT/zamboni.yml.
# `--profile path/to/file.yml` points elsewhere.
#
# Resolution order, highest first: a command-line flag, a ZAMBONI_* environment
# variable, this file, $ZAMBONI_ROOT/zamboni.yml, the built-in default. A flag
# always wins, so a one-off run overrides this file without editing it.
#
# Credentials do NOT belong here -- this file is meant to be committed. See
# env.sample and docs/devops.md §3.

# --- catalog ---------------------------------------------------------------
uri: https://lakekeeper.internal/catalog
# The warehouse to maintain -- a *database*, in Postgres/Snowflake terms. The CLI
# spells it --warehouse or --db. table-config.json also names a warehouse, but
# that one asserts rather than selects: this is what chooses, and a config file
# naming a different warehouse stops the run rather than being applied to it.
warehouse: acme

# --- engine ----------------------------------------------------------------
# `local` is PyIceberg + DuckDB. `zamboni engines` reports what each supports
# and, more usefully, what each refuses.
engine: local

# Connection settings for the non-local engines. These are *not* secrets -- a
# host, a port, a user name and a catalog name are all publishable -- which is
# why they live here rather than in .env. Unknown keys are refused, and there is
# deliberately no place for a password: if a setting is secret it belongs in
# .env, and this file is meant to be committed.
#
#trino:
#  host: trino.internal
#  port: 8080
#  user: zamboni
#  catalog: iceberg
#  version: "483"       # gates arguments only Trino >= 479 accepts
#
#spark:
#  remote: sc://spark.internal:15002   # Spark Connect; no JVM on this host
#  catalog: iceberg

# --- layout ----------------------------------------------------------------
# Per-warehouse table configuration is read from
#   {root}/configs/{warehouse}/table-config.json
# Defaults to ~/.zamboni. See docs/devops.md §5 for the multi-tenant layout.
root: /srv/zamboni

# --- what maintenance runs -------------------------------------------------
# The runbook order (docs/runbook.md §1), which is load-bearing: three of the
# five gaps between these are real constraints rather than preference. Omit the
# key entirely to run all six. List them to disable one without editing a cron
# line -- but do not reorder them.
operations:
  - compact
  - apply-properties
  - remove-dangling-deletes
  - rewrite-manifests
  - expire
  - remove-orphans

# --- table selection -------------------------------------------------------
# Default is every table in table-config.json. Narrow it only when you mean to.
#tables:
#  - acme.events
#  - acme.discharges
