# Zamboni dev stack. Copy to .env and edit if you need different values.
#
#   cp dev-stack/.env.sample dev-stack/.env
#
# .env is gitignored; .env.sample is committed. Everything here is dev-only and
# is expected to be reachable from localhost alone -- do not reuse these values
# anywhere that matters.

# --- ports -----------------------------------------------------------------
# Shifted off the defaults so this stack coexists with any other Lakekeeper or
# MinIO on the machine. Change them if these collide too.
LAKEKEEPER_PORT=8182
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
POSTGRES_PORT=5433
# Trino only starts with `--profile trino`; see docker-compose.yaml.
TRINO_PORT=8081
# Spark Connect only starts with `--profile spark`; likewise. 15012 rather
# than Spark's default 15002 for the same reason every other port here is
# shifted: a developer with any other Connect server running -- a checkout of
# iceberg-python has one -- should not have to stop it to use this stack.
SPARK_CONNECT_PORT=15012

# --- image versions --------------------------------------------------------
# Pinned so a rebuild is reproducible. `latest-main` would silently move.
LAKEKEEPER_VERSION=v0.13.1
MINIO_VERSION=RELEASE.2025-07-23T15-54-02Z
MC_VERSION=RELEASE.2025-07-21T05-28-08Z
TRINO_VERSION=483
# Spark 4 needs Java 17+, which the image carries -- with Spark Connect the JVM
# is here and not on the developer's machine, so the host's Java is irrelevant.
SPARK_VERSION=4.0.4
ICEBERG_VERSION=1.11.0

# --- postgres --------------------------------------------------------------
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=lakekeeper
POSTGRES_DB=lakekeeper

# --- lakekeeper ------------------------------------------------------------
LAKEKEEPER_ENCRYPTION_KEY=zamboni-dev-only-not-a-secret

# --- minio -----------------------------------------------------------------
MINIO_ROOT_USER=zamboni-dev-user
MINIO_ROOT_PASSWORD=zamboni-dev-password
S3_BUCKET=warehouse
S3_REGION=local-01

# The endpoint the warehouse advertises to every client. This is the compose
# network's gateway, which resolves to the host from inside the network and to
# itself from the host -- so Lakekeeper can validate the warehouse and a client
# on your laptop can read it, with no /etc/hosts entry and no name mapping.
# Must match the pinned subnet gateway in docker-compose.yaml.
S3_GATEWAY=172.31.0.1

# --- the warehouse bootstrap.py creates ------------------------------------
# STS credential vending, not remote signing. That distinction decides whether
# storage can be reclaimed at all: a remote-signing warehouse refuses
# ListObjectsV2, HeadObject and multi-object DELETE, so `expire` commits but
# frees nothing and `remove-orphans` cannot run. See docs/live-verification.md.
WAREHOUSE_NAME=zamboni
S3_STS_ENABLED=true

# --- spark -----------------------------------------------------------------
# Deliberately not UTC. Zamboni computes `older_than` on the client and sends it
# as a typed literal; a UTC server cannot tell a correct literal from one
# missing its offset, so a UTC session here would certify the bug ZMBNI-1507
# fixed. Change it freely -- any non-UTC zone does the job.
SPARK_SESSION_TIMEZONE=America/New_York
